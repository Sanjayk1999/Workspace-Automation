<UserControl x:Class="WorkspaceAuto.Views.AddWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WorkspaceAuto.ViewModels"
             xmlns:local="clr-namespace:WorkspaceAuto.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Text="Capture Workspace"
            FontSize="20"
            Foreground="White"
            HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
            <TextBlock Text="Workspace Details" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="7"/>
            <TextBlock Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,5,10,5"/>
            <TextBox Width="250" Height="35" Style="{StaticResource TextBoxStyle}" Text="{Binding WorkspaceName}" Margin="0,5,10,5"/>
            <Button
            Style="{StaticResource SecondaryButtonStyle}"
            HorizontalAlignment="Right"
            Width="250"
            Margin="0,5,10,5"
            Content="Save Workspace"
            Command="{Binding SaveWorkspaceCommand}"
            />
        </StackPanel>
        <!--<TextBlock Grid.Row="2" Text="Running Apps" FontSize="12" Foreground="White" Margin="10,5"/>-->

        <ScrollViewer Margin="0,20,0,0" Grid.Row="1" Grid.Column="0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}"
               BasedOn="{StaticResource ModernScrollBarStyle}">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="MaxWidth" Value="6"/>
                </Style>
            </ScrollViewer.Resources>

            <ItemsControl ItemsSource="{Binding WorkSpaceItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#111C27"
                            BorderBrush="#263442"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Selection checkbox -->
                                <CheckBox
                                    Grid.Column="0"
                                    Style="{StaticResource AppSelectionCheckBoxStyle}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="4,0,16,0"/>

                                <!-- Application details -->
                                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                                    <!-- Application name -->
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#F1F5F9"
                                        TextTrimming="CharacterEllipsis"/>

                                    <!-- Executable path -->
                                    <TextBlock
                                        Text="{Binding ExecutablePath}"
                                        FontSize="12"
                                        Foreground="#94A3B8"
                                        Margin="0,4,0,0"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ExecutablePath}"/>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>
    </Grid>
</UserControl>
